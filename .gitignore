# Dependencies — rebuilt by `npm install`, never committed
node_modules/

# The live database and its write-ahead-log sidecars — your trip's data, never commit it
*.db
*.db-shm
*.db-wal

# Secrets and logs
.env
.env.*
# Real instance map for deploy/deploy.sh (names, dirs, ports) — examples ship in
# deploy/instances.conf; your actual rows stay local
deploy/instances.local.conf
# Real deploy credentials (SERVER/SSH_KEY) for deploy.sh + deploy-hub.sh —
# template ships deploy/deploy.local.env.example
deploy/deploy.local.env
# family-hub's runtime config (.env is already covered above, listed here for
# grep-ability) and its dev-only instance map — example ships as
# family-hub/instances.dev.json.example
family-hub/.env
family-hub/instances.dev.json
*.log
npm-debug.log*

# TLS material (local HTTPS experiments, certs, keys) — never commit
*.pem
*.key
*.crt

# Ad-hoc database backups (e.g. data.db.backup-YYYY-MM-DD)
*.db.backup*

# Safety copies made by tools/apply-trip-data.js (index.html / server.js)
*.backup-*

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Real trip content fed to tools/apply-trip-data.js — family names, addresses,
# reservations. The workshop repo ships only the sample trip in public/index.html;
# your real JSON lives in its own trip folder (~/code/family-trip-<name>/).
my-trip.json
trip-data.json
*-trip.json
