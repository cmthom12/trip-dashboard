# deploy/deploy.local.env.example — copy to deploy/deploy.local.env and fill in.
#
# deploy.local.env is gitignored: it holds YOUR server address and key path so
# the tracked scripts (deploy/deploy.sh and admin-hub/deploy-hub.sh) never need
# editing. It is sourced as shell, so $HOME etc. expand; quote values.

SERVER="root@203.0.113.10"
SSH_KEY="$HOME/.ssh/id_ed25519"

# Hub-only overrides (admin-hub/deploy-hub.sh) — uncomment to change:
#HUB_DIR="/var/www/admin-hub"   # NEVER under /var/www/trips (self-discovery hazard)
#HUB_PORT="3010"                # must match the hub's .env PORT

# new-trip.sh (one-command stand-up) — REQUIRED by that script, ignored by the rest:
#PUBLIC_SUFFIX="trips.example.com"   # instance <name> is served at https://<name>.<PUBLIC_SUFFIX>
#CERT_EMAIL="you@example.com"        # Let's Encrypt renewal/expiry notices (certbot --email)
# Optional port policy for new-trip.sh. The band is where instance ports are
# auto-selected (lowest free); PORT_RESERVED is a space-separated list that is
# never chosen and refused if asked for with --port (e.g. a port kept for a
# retired trip that may come back, or one used by something outside /var/www/trips).
#PORT_BAND_MIN="3001"
#PORT_BAND_MAX="3009"
#PORT_RESERVED="3007"
