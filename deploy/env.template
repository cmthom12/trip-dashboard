# deploy/env.template — per-instance environment for one trip-dashboard instance.
#
# On the droplet:   cp env.template /var/www/trips/<name>/.env
#                   nano /var/www/trips/<name>/.env     (fill in real values)
#                   chmod 600 /var/www/trips/<name>/.env
# NEVER commit a real .env to git (.gitignore blocks it) and deploy.sh never
# ships one — each instance's .env lives only on the droplet.
#
# PORT        — this instance's localhost port. Must match its row in
#               deploy/instances.conf AND the nginx proxy_pass for its domain.
# NODE_ENV    — leave as production on the droplet.
# ADMIN_KEY   — long random string (e.g. `openssl rand -hex 32`). If left empty
#               the admin console is disabled: every /api/admin/* route
#               returns 404 and admin stays invisible.
# CORS_ORIGIN — exact https origin of this instance (scheme + host, no slash).
#               If left empty the server stays on the permissive template
#               default (Access-Control-Allow-Origin: *).
# PIN_PEPPER  — optional. Keys the PIN hash (HMAC-SHA256) so a leaked users
#               table isn't a 10,000-entry rainbow table away from every 4-digit
#               PIN. EMPTY = the original bare-sha256 scheme, unchanged. Set it
#               and each person migrates silently on their next sign-in — no
#               reset needed. Never change or clear it once set: PINs hashed
#               under the old value stop matching and must be reset.
PORT=3001
NODE_ENV=production
ADMIN_KEY=
CORS_ORIGIN=https://trip-a.example.com
PIN_PEPPER=
