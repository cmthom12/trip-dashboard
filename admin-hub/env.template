# admin-hub/env.template — environment for the aggregate admin hub.
#
# On the droplet:   cp env.template /var/www/admin-hub/.env
#                   chmod 600 /var/www/admin-hub/.env
#
# Deliberately NO ADMIN_KEY here: the hub stores no secrets. The admin key is
# typed into the hub page, held in the browser tab's sessionStorage, and
# forwarded per-request to each instance — never configured or persisted
# server-side.
#
# HAZARD: the hub's home is /var/www/admin-hub — NEVER under /var/www/trips,
# or the hub would discover itself as an "instance" and backup-all.sh would
# sweep it. See docs/MULTI_INSTANCE.md §ADMIN-HUB.
#
# PORT     — the hub's localhost port (nginx proxy_pass target for the admin domain).
# NODE_ENV — leave as production on the droplet.
PORT=3010
NODE_ENV=production
